<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ring"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="32dp"
    android:paddingTop="64dp"
    android:paddingRight="32dp"
    android:paddingBottom="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.4"
        android:text="闹钟"
        android:textColor="@color/accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ring_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.01"
        android:text="07:30"
        android:textColor="?attr/text_primary"
        android:textSize="84sp" />

    <TextView
        android:id="@+id/ring_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="起床"
        android:textColor="?attr/text_primary"
        android:textSize="19sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ring_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="系统默认铃声"
        android:textColor="?attr/text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ring_ai_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:text=""
        android:textColor="@color/accent"
        android:textSize="15sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btn_snooze"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_ring_snooze"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="稍后\n提醒"
                android:textColor="?attr/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.15"
                android:text="SNOOZE"
                android:textColor="?attr/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btn_stop"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_ring_stop"
                android:gravity="center"
                android:text="停止"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.15"
                android:text="DISMISS"
                android:textColor="?attr/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/ring_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="闹钟会在 10 分钟后自动停止"
        android:textColor="?attr/text_tertiary"
        android:textSize="11sp" />
</LinearLayout>
